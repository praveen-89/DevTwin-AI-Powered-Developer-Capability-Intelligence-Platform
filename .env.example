# =============================================================================
# DevTwin — Environment Variable Template
#
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# NEVER put real credentials in this file.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=DevTwin API
APP_VERSION=0.1.0
DEBUG=false

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
# Use the transaction-mode pooler connection string from Supabase dashboard.
# Must use the postgresql+asyncpg:// scheme for async compatibility.
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# WARNING: SUPABASE_SERVICE_ROLE_KEY bypasses RLS. Never expose to frontend.

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. No wildcards in production.
CORS_ORIGINS=http://localhost:3000

# ── GitHub App Integration ────────────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GITHUB_PRIVATE_KEY should be a PEM string (newlines escaped if needed). Never commit the real key.
GITHUB_PRIVATE_KEY=
# The BACKEND OAuth callback URL
GITHUB_REDIRECT_URL=http://localhost:8000/github/callback
# GITHUB_STATE_ENCRYPTION_KEY must be a valid 32-byte base64-encoded Fernet key.
GITHUB_STATE_ENCRYPTION_KEY=
GITHUB_STATE_TTL_SECONDS=600
GITHUB_API_BASE_URL=https://api.github.com
